#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define MOU  4

/ {

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "toucan";
            bindings = <
            &trans      &kp Q               &kp W       &kp E    &kp R            &kp T             &kp Y          &kp U          &kp I        &kp O      &kp P             &trans
            &trans      &kp A               &kp S       &kp D    &lt 2 F          &kp G             &kp H          &kp J          &kp K        &kp L      &kp BACKSPACE     &trans
            &trans      &mt LEFT_ALT Z      &kp X       &kp C    &kp V            &kp B             &kp N          &kp M          &kp COMMA    &kp DOT    &kp SQT           &trans
                                       &mo 4      &mt LCTRL TAB    &kp LEFT_SHIFT    &lt 1 SPACE    &lt 3 ENTER        &kp LEFT_GUI
            >;
        };

        nav {
            display-name = "ext";
            bindings = <
            &trans      &kp LC(LA(DEL))    &none            &none    &none     &kp LC(LS(T))    &kp PAGE_UP         &kp HOME      &kp UP          &kp END            &kp DEL        &trans
            &trans      &none              &kp LG(LS(S))    &none    &none     &none            &kp PAGE_DOWN       &kp LEFT      &kp DOWN        &kp RIGHT          &none          &trans
            &trans      &trans             &trans           &none    &none     &none            &kp K_PLAY_PAUSE    &kp C_MUTE    &kp C_VOL_DN    &kp C_VOLUME_UP    &none          &trans
                                            &trans    &trans    &trans           &trans              &trans     &trans
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
            &trans      &kp ESCAPE      &kp MINUS               &kp EQUAL                &none     &none            &none            &kp N7          &kp N8          &kp N9          &kp GRAVE      &trans
            &trans      &kp QUESTION    &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS    &trans    &kp COLON        &kp UNDERSCORE   &kp NUMBER_4    &kp N5          &kp NUMBER_6    &trans         &trans
            &trans      &kp SLASH       &kp LEFT_BRACKET        &kp RIGHT_BRACKET        &none     &kp SEMICOLON    &kp BACKSLASH    &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3    &trans         &trans
                                                         &trans        &trans    &trans           &trans           &kp N0       &kp DOT
            >;
        };

        adj {
            display-name = "fnc";
            bindings = <
            &trans      &kp F1              &kp F2     &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10     &trans
            &trans      &kp F11             &kp F12    &none     &none     &none     &none     &none     &none     &none     &none       &trans
            &trans      &studio_unlock      &trans     &none     &none     &none     &none     &none     &none     &none     &mo 4       &trans
                                &trans      &trans    &trans    &none     &trans        &trans
            >;
        };

        mou {
            display-name = "mouse";
            bindings = <
            &trans      &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &trans
            &trans      &mkp MCLK   &mkp RCLK   &mkp LCLK   &none       &none       &none       &none       &none       &none       &none       &trans
            &trans      &trans      &none       &none       &none       &none       &none       &none       &none       &none       &none       &trans
                                &trans      &trans    &trans    &trans     &trans        &trans
            >;
        };
    };
};